TELEGRAM_BOT_TOKEN=123456789:replace-with-bot-token
TELEGRAM_CHAT_ID=
TELEGRAM_START_PIN=replace-with-pin
BOT_OWNER_NUMBER=15550001111
PHONE_NUMBER=15550001111

# Optional AI features (chat summaries, reply drafting, transcription, AI images).
# Gemini 2.5 Flash is the default provider for all of them. Set one default key here;
# when it is present, chat/basics use Gemini even if MONTRA_AI_API_KEY is empty.
MONTRA_DEFAULT_GEMINI_API_KEY=
GEMINI_API_KEY=
# Optional custom provider key (OpenAI/Anthropic-compatible). Only used when set.
MONTRA_AI_API_KEY=
MONTRA_AI_MODEL=gemini-2.5-flash
MONTRA_TRANSCRIBE_MODEL=whisper-1
MONTRA_IMAGE_MODEL=gemini-2.5-flash-image
# Only used for a custom MONTRA_AI_API_KEY provider.
MONTRA_AI_BASE_URL=https://api.openai.com/v1/chat/completions

# Optional authenticated local dashboard (leave token empty for open preview mode)
DASHBOARD_TOKEN=
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=3000

# One-time message (OTM) API key. Separate from DASHBOARD_TOKEN: OTM links use this
# key so the dashboard token is never exposed. Use at least 8 random characters.
MONTRA_OTM_KEY=

# Timezone for wall-clock schedules and displays (IANA name, e.g. Africa/Nairobi).
# Leave empty to use the server zone. Runtime /time overrides land in data/timeConfig.json.
MONTRA_TIMEZONE=
# Optional manual clock correction in minutes when the host clock itself is wrong.
# The user clock is server time + this value (e.g. 90 or -60). Keep 0 when possible.
MONTRA_TIME_SHIFT_MINUTES=0

# Local sync cache controls; retention disabled by default (0)
SYNC_MAX_MESSAGES_PER_CHAT=500
SYNC_RETENTION_DAYS=0

# Persistent WhatsApp chat/status media archive (LRU eviction when total cap is reached)
MEDIA_ARCHIVE_MAX_MB=500
MEDIA_ARCHIVE_MAX_FILE_MB=200

# Daily local snapshots (session credentials are excluded); hour uses the user timezone
BACKUP_HOUR=3
BACKUP_KEEP_COUNT=7

# Optional server-side Google OAuth refresh credentials (preview works via Firebase Auth popup without these)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

